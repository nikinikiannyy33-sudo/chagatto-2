const port = Number(process.env.PORT || 8080);
const internalBaseUrl = `http://127.0.0.1:${port}`;

serve({
  fetch: app.fetch,
  port,
  hostname: "0.0.0.0",
});

console.log(`Chagatto-2 started PORT=${port}`);

// JST毎時05分に自動判定。
// 30秒ごとに時計を確認するが、同じJST時間帯では1回だけ実行する。
setInterval(async () => {
  const p = jstParts();

  if (p.minute !== AUTO_RUN_MINUTE_JST || schedulerInProgress) return;

  const hourKey = jstHourKey();
  if (lastScheduledHourKey === hourKey) return;

  lastScheduledHourKey = hourKey;
  schedulerInProgress = true;

  try {
    const adminToken = process.env.ADMIN_TOKEN;

    if (!adminToken) {
      lastSchedulerResult = {
        time: new Date().toISOString(),
        hourKey,
        error: "ADMIN_TOKEN_NOT_SET",
      };
      return;
    }

    const result = await runAutoFlow(internalBaseUrl, adminToken);

    lastSchedulerResult = {
      time: new Date().toISOString(),
      hourKey,
      httpStatus: result.status,
      ...result.data,
    };

    console.log("Hourly auto-run:", JSON.stringify(lastSchedulerResult));
  } catch (error) {
    lastSchedulerResult = {
      time: new Date().toISOString(),
      hourKey,
      error: error instanceof Error ? error.message : String(error),
    };

    console.error("Hourly auto-run failed:", error);
  } finally {
    schedulerInProgress = false;
  }
}, 30_000);
